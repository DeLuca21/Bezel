<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.bezel" path="/org/gnome/shell/extensions/bezel/">
    <key name="wallpaper-palette" type="s"><default>'{}'</default></key>
    <key name="wallpaper-status" type="s"><default>''</default></key>
    <key name="wallpaper-swatch" type="i"><default>-1</default><range min="-1" max="5"/></key>
    <key name="wallpaper-variant" type="s"><default>'muted'</default><choices><choice value="muted"/><choice value="vibrant"/><choice value="monochrome"/></choices></key>
    <key name="wallpaper-style" type="s"><default>'system'</default><choices><choice value="system"/><choice value="light"/><choice value="dark"/></choices></key>
    <key name="settings-layout" type="s"><default>'sidebar'</default><choices><choice value="classic"/><choice value="sidebar"/></choices><summary>Settings window layout</summary></key>
    <key name="liquid-motion" type="b"><default>false</default></key>
    <key name="liquid-glass-drawers" type="b"><default>false</default></key>
    <key name="liquid-glass-docks" type="b"><default>false</default></key>
    <key name="liquid-glass-panels" type="b"><default>false</default></key>
    <key name="liquid-glass-frame" type="b"><default>false</default></key>
    <key name="liquid-live-blur" type="b"><default>false</default></key>
    <key name="liquid-edge-highlight" type="b"><default>false</default><summary>Highlight glass edges</summary></key>
    <key name="disable-startup-overview" type="b"><default>false</default><summary>Disable overview on startup</summary></key>
    <key name="liquid-hover-hold" type="i"><default>1200</default><range min="0" max="10000"/></key>
    <key name="liquid-shift" type="b"><default>false</default></key>
    <key name="liquid-pour" type="b"><default>false</default></key>
    <key name="liquid-open-style" type="s"><default>'grow'</default><choices><choice value="grow"/><choice value="drip"/><choice value="drip-grow"/><choice value="drop-expand"/><choice value="unfold"/></choices></key>
    <key name="liquid-blur-radius" type="i"><default>24</default><range min="0" max="64"/></key>
    <key name="liquid-tint" type="i"><default>18</default><range min="0" max="100"/></key>
    <key name="liquid-duration-scale" type="i"><default>100</default><range min="25" max="300"/></key>

    <key name="layout-transition" type="s"><default>'retreat'</default><choices><choice value="none"/><choice value="fade"/><choice value="slide"/><choice value="retreat"/><choice value="wipe"/></choices></key>
    <key name="layout-transition-duration" type="i"><default>500</default><range min="0" max="1600"/></key>
    <key name="layout-transition-request" type="i"><default>0</default></key>
    <key name="preferences-target" type="s"><default>''</default></key>
    <key name="launcher-layout-undo" type="s"><default>''</default></key>
    <key name="launcher-web-engine" type="s"><default>'ddg'</default><choices><choice value="ddg"/><choice value="g"/><choice value="yt"/><choice value="w"/><choice value="gh"/></choices></key>
    <key name="launcher-files" type="b"><default>true</default></key>
    <key name="launcher-file-roots" type="as"><default>['~']</default></key>
    <key name="config" type="s">
      <default>""</default>
    </key>
    <key name="edit-mode" type="b">
      <default>false</default>
    </key>
    <key name="show-settings" type="i">
      <default>0</default>
      <summary>Increment to open the Bezel settings window</summary>
    </key>
    <key name="edge-panels" type="b">
      <default>true</default>
      <summary>Open the dashboard and session drawer from the center of the screen edges</summary>
    </key>

    <key name="launcher-shortcut" type="as"><default>['&lt;Super&gt;space']</default></key>
    <key name="overview-shortcut" type="as"><default>[]</default></key>
    <key name="shortcut-overrides" type="s"><default>"[]"</default></key>
    <key name="super-launcher" type="b"><default>false</default></key>
    <key name="launcher-width" type="i"><default>600</default><range min="360" max="1000"/></key>
    <key name="panel-indicators" type="b"><default>true</default></key>
    <key name="indicator-bar" type="i"><default>0</default><range min="0" max="4"/></key>
    <key name="indicator-monitor" type="s"><default>''</default><summary>Connector of the display that hosts extension icons</summary></key>
    <key name="indicator-avoid-fullscreen" type="b"><default>true</default><summary>Move extension icons when their display is fullscreen</summary></key>
    <key name="saved-layouts" type="s"><default>"[]"</default></key>
    <key name="indicator-spacing" type="i"><default>16</default><range min="0" max="40"/></key>
    <key name="indicator-order" type="as"><default>[]</default></key>
    <key name="indicator-side" type="s">
      <default>"after"</default>
      <choices>
        <choice value="before"/>
        <choice value="after"/>
      </choices>
    </key>
    <key name="known-indicators" type="as"><default>[]</default></key>
    <key name="frame-notifications" type="b"><default>true</default></key>
    <key name="indicator-icon-size" type="i"><default>22</default><range min="12" max="40"/></key>
    <key name="previous-layout" type="s"><default>""</default></key>
    <key name="layout-baseline" type="s"><default>""</default><summary>Last saved or applied layout, used to detect unsaved changes</summary></key>
    <key name="power-hover" type="b"><default>false</default></key>
    <key name="clock-hover" type="b"><default>true</default></key>
    <key name="power-button-hover" type="b"><default>true</default></key>
    <key name="dashboard-hover" type="b"><default>true</default></key>
    <key name="status-hover" type="b"><default>true</default></key>
    <key name="hover-delay" type="i"><default>300</default><range min="100" max="1000"/></key>
    <key name="animation-duration" type="i"><default>320</default><range min="0" max="800"/></key>
    <key name="login-animation" type="b">
      <default>false</default>
      <summary>Animate login</summary>
      <description>Reveal the desktop and configured bars together when the session starts. Respects reduced motion and disabled animations.</description>
    </key>
    <key name="lock-animation" type="b">
      <default>false</default>
      <summary>Animate lock</summary>
      <description>Play a decorative reveal over the lock screen using the selected animation style and speed. Respects reduced motion.</description>
    </key>
    <key name="unlock-animation" type="b">
      <default>false</default>
      <summary>Animate unlock</summary>
      <description>Reveal the desktop and configured bars after the lock screen disappears. Uses the selected animation style and speed and respects reduced motion.</description>
    </key>
    <key name="preview-login-animation" type="i">
      <default>0</default>
      <summary>Increment to preview the login animation</summary>
    </key>
    <key name="login-animation-theme" type="s">
      <default>'liquid'</default>
      <choices><choice value="liquid"/><choice value="curtain"/><choice value="cascade"/><choice value="fade"/><choice value="glide"/><choice value="soft-fade"/></choices>
      <summary>Session animation theme</summary>
    </key>
    <key name="login-animation-speed" type="i">
      <default>100</default><range min="25" max="200"/>
      <summary>Session animation speed as a percentage</summary>
      <description>100 preserves the normal timing. Lower values slow down the animation; higher values speed it up. Applies to login, lock, unlock and previews.</description>
    </key>
    <key name="frame-shadow" type="i"><default>8</default><range min="0" max="24"/></key>
    <key name="dashboard-width" type="i"><default>880</default><range min="480" max="1200"/></key>

    <key name="theme" type="s">
      <default>"catppuccin-mocha"</default>
      <choices>
        <choice value="catppuccin-latte"/>
        <choice value="catppuccin-frappe"/>
        <choice value="catppuccin-macchiato"/>
        <choice value="catppuccin-mocha"/>
        <choice value="nord"/>
        <choice value="rose-pine"/>
        <choice value="rose-pine-moon"/>
        <choice value="rose-pine-dawn"/>
        <choice value="bezel-forest"/>
        <choice value="bezel-sage"/>
        <choice value="bezel-ocean"/>
        <choice value="bezel-sand"/>
        <choice value="bezel-ember"/>
        <choice value="bezel-monochrome"/>
        <choice value="wallpaper"/>
        <choice value="custom"/>
      </choices>
    </key>
    <key name="custom-bg" type="s">
      <default>"#1e1e2e"</default>
    </key>
    <key name="custom-surface" type="s">
      <default>"#313244"</default>
    </key>
    <key name="custom-fg" type="s">
      <default>"#cdd6f4"</default>
    </key>
    <key name="custom-muted" type="s">
      <default>"#a6adc8"</default>
    </key>
    <key name="custom-accent" type="s">
      <default>"#cba6f7"</default>
    </key>
    <key name="custom-group" type="s">
      <default>"#94e2d5"</default>
    </key>
    <key name="custom-border" type="s">
      <default>"#45475a"</default>
    </key>

    <key name="bar-edge" type="s">
      <default>"top"</default>
      <choices>
        <choice value="top"/>
        <choice value="bottom"/>
        <choice value="left"/>
        <choice value="right"/>
      </choices>
    </key>
    <key name="bar-behavior" type="s">
      <default>"static"</default>
      <choices>
        <choice value="static"/>
        <choice value="autohide"/>
      </choices>
    </key>
    <key name="popout-placement" type="s">
      <default>"attached"</default>
      <choices>
        <choice value="attached"/>
        <choice value="centered"/>
      </choices>
    </key>
    <key name="margin-ends" type="i">
      <default>0</default>
      <range min="0" max="800"/>
    </key>
    <key name="margin-edge" type="i">
      <default>0</default>
      <range min="0" max="200"/>
    </key>
    <key name="thickness" type="i">
      <default>42</default>
      <range min="24" max="160"/>
    </key>
    <key name="radius" type="i">
      <default>0</default>
      <range min="0" max="80"/>
    </key>
    <key name="opacity" type="d">
      <default>1.0</default>
      <range min="0.2" max="1.0"/>
    </key>
    <key name="border-width" type="i">
      <default>0</default>
      <range min="0" max="8"/>
    </key>
    <key name="reserve-space" type="b">
      <default>true</default>
    </key>
    <key name="overview-background" type="s"><choices><choice value="off"/><choice value="dimmed"/><choice value="blurred"/><choice value="gradient"/></choices><default>'off'</default><summary>Overview background style</summary></key>
    <key name="overview-dim" type="i"><range min="0" max="100"/><default>35</default></key>
    <key name="overview-blur" type="i"><range min="0" max="100"/><default>30</default></key>
    <key name="overview-gradient-strength" type="i"><range min="0" max="100"/><default>35</default></key>
    <key name="hide-overview-dock" type="b"><default>true</default><summary>Hide the built-in dock in GNOME Overview</summary></key>
    <key name="hide-gnome-panel" type="b">
      <default>true</default>
    </key>

    <key name="widgets-start" type="as">
      <default>["overview", "workspaces"]</default>
    </key>
    <key name="widgets-center" type="as">
      <default>["clock"]</default>
    </key>
    <key name="widgets-end" type="as">
      <default>["session"]</default>
    </key>

    <key name="show-frame" type="b">
      <default>true</default>
    </key>
    <key name="frame-inset" type="i">
      <default>8</default>
      <range min="0" max="80"/>
    </key>
    <key name="frame-width" type="i">
      <default>12</default>
      <range min="4" max="48"/>
    </key>
    <key name="frame-radius" type="i">
      <default>28</default>
      <range min="0" max="80"/>
    </key>
    <key name="hidden-indicators" type="as"><default>[]</default><summary>Extension roles hidden from Bezel</summary></key>
    <key name="power-position" type="s"><default>'icon'</default><summary>Power drawer position</summary></key>
    <key name="power-style" type="s">
      <default>'list'</default>
      <summary>Power menu layout</summary>
      <choices>
        <choice value="list"/>
        <choice value="rail"/>
      </choices>
    </key>
    <key name="slider-style" type="s">
      <default>'drawer'</default>
      <summary>Volume and brightness controls</summary>
      <choices>
        <choice value="drawer"/>
        <choice value="edge"/>
      </choices>
    </key>
    <key name="session-dim" type="b">
      <default>false</default>
      <summary>Dim the desktop behind the power menu</summary>
    </key>
    <key name="dashboard-position" type="s"><default>'icon'</default><summary>Dashboard drawer position</summary></key>
    <key name="notifications-max-height" type="i"><default>480</default><range min="240" max="1600"/><summary>Maximum notification history height in pixels</summary></key>
    <key name="notifications-order" type="s">
      <default>'newest-first'</default>
      <choices><choice value="newest-first"/><choice value="oldest-first"/></choices>
      <summary>Notification history order</summary>
    </key>
    <key name="notifications-position" type="s"><default>'top-right'</default><summary>Notification history and arrival position</summary></key>
    <key name="weather-dashboard" type="b"><default>true</default><summary>Show weather on dashboard</summary></key>
    <key name="weather-clock" type="b"><default>false</default><summary>Show weather beside clock</summary></key>
    <key name="date-format" type="s">
      <default>'medium'</default>
      <summary>Fallback date format for bars that have not chosen one</summary>
      <choices>
        <choice value="weekday"/>
        <choice value="short"/>
        <choice value="medium"/>
        <choice value="long"/>
        <choice value="numeric"/>
        <choice value="iso"/>
      </choices>
    </key>
    <key name="dashboard-date-format" type="s">
      <default>'long'</default>
      <summary>Date format on the dashboard</summary>
      <choices>
        <choice value="weekday"/>
        <choice value="short"/>
        <choice value="medium"/>
        <choice value="long"/>
        <choice value="numeric"/>
        <choice value="iso"/>
      </choices>
    </key>
    <key name="dashboard-time-format" type="s">
      <default>'24h'</default>
      <summary>Time format on the dashboard</summary>
      <choices>
        <choice value="24h"/>
        <choice value="12h"/>
      </choices>
    </key>
    <key name="dashboard-clock-seconds" type="b">
      <default>false</default>
      <summary>Show seconds on the dashboard clock</summary>
    </key>
    <key name="preferences-group" type="s"><default>''</default><summary>Group selected in the popout editor</summary></key>
    <key name="group-preview" type="s"><default>''</default><summary>Live group preview request</summary></key>
    <key name="preferences-bar" type="i"><default>-1</default><range min="-1" max="3"/><summary>Selected bar in the preferences window</summary></key>
  </schema>
</schemalist>
